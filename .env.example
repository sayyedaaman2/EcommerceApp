DATABASE_URL="mysql://ecommerce_user:ecommerce_password@localhost:3306/ecommerce_app"

DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_USER='user'
DATABASE_PASSWORD='password'
DATABASE_NAME='mydb'

PORT=1000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

JWT_SECRET_KEY="SECRET-TOKEN"